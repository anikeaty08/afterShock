# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# ── FalkorDB ──────────────────────────────────────────────────
# Host port is 16379, not FalkorDB's usual 6379 — on a machine where WSL2
# is installed, WSL's own localhost relay can already own 127.0.0.1:6379,
# silently shadowing Docker's forwarded port. See infra/docker-compose.yml.
FALKORDB_HOST=localhost
FALKORDB_PORT=16379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# ── LLM (via LiteLLM — "provider/model", any LiteLLM-supported provider) ──
ANSWER_MODEL=bedrock/global.anthropic.claude-sonnet-4-6
JUDGE_MODEL=bedrock/global.amazon.nova-2-lite-v1:0
EMBED_MODEL=bedrock/amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=256
EXTRACT_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
NER_BACKEND=llm

# Provider keys — set whichever your ANSWER_MODEL / JUDGE_MODEL need.
OPENAI_API_KEY=
# AWS Bedrock (API key auth) — used by the defaults above
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION_NAME=ap-south-1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── GitHub App (§10.2) ────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ── API service ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=false
LOG_LEVEL=INFO
