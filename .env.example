# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# ── FalkorDB ──────────────────────────────────────────────────
# Host port is 16379, not FalkorDB's usual 6379 — on a machine where WSL2
# is installed, WSL's own localhost relay can already own 127.0.0.1:6379,
# silently shadowing Docker's forwarded port. See infra/docker-compose.yml.
FALKORDB_HOST=localhost
FALKORDB_PORT=16379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# ── LLM (via LiteLLM — "provider/model", any LiteLLM-supported provider) ──
ANSWER_MODEL=openai/gpt-5.5-mini
JUDGE_MODEL=anthropic/claude-haiku-4-5
EMBED_MODEL=openai/text-embedding-3-large
EMBED_DIMENSIONS=256

# Provider keys — set whichever your ANSWER_MODEL / JUDGE_MODEL need.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── GitHub App (§10.2) ────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# ── API service ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEMO_MODE=false
LOG_LEVEL=INFO
